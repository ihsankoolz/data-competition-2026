# Copy to .env. Never commit .env.
LLM_MODE=replay              # replay (default, offline demo) | record | live
ANTHROPIC_API_KEY=           # only needed for record/live
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_JUDGE=claude-sonnet-5-5
FIELD_ENCRYPTION_KEY=        # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
API_PORT=8000
SAP_MOCK_PORT=8001
SAP_BASE_URL=http://localhost:8001/b1s/v2
SAP_COMPANY_DB=LIVES_DEMO
SAP_USER=mdm_integration
SAP_PASSWORD=demo
