{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New item",
  "description": "An item (ItemType itItems) in the shared SAP Business One. Registrations per country live in the MDM app (production: a B1 user-defined table).",
  "type": "object",
  "x-domain": "item",
  "x-order": [
    "ItemName",
    "product_family",
    "ItemsGroupCode",
    "SalesUnit",
    "U_IVD",
    "selling_countries",
    "registrations",
    "unit_price_usd",
    "purpose"
  ],
  "properties": {
    "ItemName": { "type": "string", "maxLength": 100, "title": "Item name", "x-extract": "item_name" },
    "product_family": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "title": "Product family",
      "description": "A = reagents and kits (SPD), B = equipment (QTS), C = service (QTG).",
      "x-app-only": true
    },
    "ItemsGroupCode": {
      "type": "integer",
      "title": "Item group",
      "oneOf": [
        { "const": 101, "title": "Reagents and test kits" },
        { "const": 102, "title": "Analysers and equipment" },
        { "const": 103, "title": "Service contracts" }
      ]
    },
    "SalesUnit": {
      "type": "string",
      "maxLength": 100,
      "title": "Sales unit",
      "description": "For example: box of 25.",
      "x-extract": "sales_unit"
    },
    "U_IVD": {
      "type": "string",
      "enum": ["tYES", "tNO"],
      "title": "In-vitro diagnostic (IVD)?",
      "description": "IVD items need a registration number in every country they are sold in.",
      "x-extract": "is_ivd",
      "x-extract-map": { "true": "tYES", "false": "tNO" }
    },
    "selling_countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["SG", "MY", "ID", "VN", "TH"] },
      "title": "Selling countries",
      "x-extract": "selling_countries",
      "x-app-only": true
    },
    "registrations": {
      "type": "array",
      "title": "Registration per selling country",
      "description": "One row per selling country. Quality/Regulatory checks each one.",
      "x-app-only": true,
      "x-extract-per-country": "registration_number_{country}",
      "items": {
        "type": "object",
        "required": ["country", "reg_no"],
        "properties": {
          "country": { "type": "string", "enum": ["SG", "MY", "ID", "VN", "TH"], "title": "Country" },
          "reg_no": { "type": "string", "maxLength": 40, "title": "Registration number" },
          "risk_class": { "type": "string", "enum": ["A", "B", "C", "D"], "title": "Risk class" },
          "issue_date": { "type": "string", "format": "date", "title": "Issue date" },
          "expiry_date": { "type": "string", "format": "date", "title": "Expiry date" }
        }
      }
    },
    "unit_price_usd": {
      "type": "number",
      "minimum": 0,
      "title": "List price (USD)",
      "x-extract": "unit_price_usd",
      "x-app-only": true
    },
    "purpose": {
      "type": "string",
      "maxLength": 200,
      "title": "Why is this item needed?",
      "x-app-only": true
    }
  }
}
